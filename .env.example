# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored — never commit real keys.
# ---------------------------------------------------------------------------

# --- Model providers (fill at least one) ---
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# --- Model routing ---
# Which provider handles each role. One of: gemini | anthropic | deepseek | openai
LLM_REASONER=gemini
LLM_FAST=gemini
LLM_VISION=gemini

# Per-provider model ids (override only if you need a specific one)
GEMINI_MODEL=gemini-2.5-pro
GEMINI_FAST_MODEL=gemini-2.5-flash
ANTHROPIC_MODEL=claude-sonnet-5
# deepseek-flash (V4.1-Flash) or deepseek-v4-pro (V4-Pro-0813). Use flash: it
# wins nearly every benchmark, costs ~3x less, has vision, and allows 5x the
# concurrency. See docs/MODELS.md. v4-pro has NO vision support.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DeepSeek also serves an Anthropic-format endpoint, unused for now:
# https://api.deepseek.com/anthropic

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Service ---
AGENT_HOST=0.0.0.0
AGENT_PORT=8000
AGENT_CORS_ORIGINS=http://localhost:3000

# --- NAIOM platform (naiom-platform/.env.local) ---
# OWNED_AGENT selects which of the three agents the platform serves.
# One of: veille | prospection | proposition
OWNED_AGENT=veille
APIFY_TOKEN=
FIREFLIES_API_KEY=
