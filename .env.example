# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored — never commit real keys.
# ---------------------------------------------------------------------------

# --- Model providers (fill at least one) ---
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# --- Model routing ---
# Which provider handles each role. One of: gemini | anthropic | deepseek | openai
LLM_REASONER=gemini
LLM_FAST=gemini
LLM_VISION=gemini

# Per-provider model ids (override only if you need a specific one)
GEMINI_MODEL=gemini-2.5-pro
GEMINI_FAST_MODEL=gemini-2.5-flash
ANTHROPIC_MODEL=claude-sonnet-5
# Set DEEPSEEK_MODEL to whatever `GET /models` returns for your account.
# Verify before the demo:  curl -H "Authorization: Bearer $DEEPSEEK_API_KEY" \
#                               https://api.deepseek.com/models
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Service ---
AGENT_HOST=0.0.0.0
AGENT_PORT=8000
AGENT_CORS_ORIGINS=http://localhost:3000

# --- NAIOM platform (naiom-platform/.env.local) ---
# OWNED_AGENT selects which of the three agents the platform serves.
# One of: veille | prospection | proposition
OWNED_AGENT=veille
APIFY_TOKEN=
FIREFLIES_API_KEY=
